module R4C.Mechanics
     where
import UniformBase (putIOwords)
import qualified Data.Map.Strict as M


import R4C.Countries  -- this is the data 


newtype Year = Year Int
    deriving (Eq, Ord, Show)

-- data Indicator
--     = Population
--     | GDP
--     | Area
--     | LifeExpectancy
--     | CO2
--     | PopulationDensity
--     deriving (Eq, Ord, Show)

-- popx = Indicator
--   { code = "POP"
--   , name = "Population"
--   , unit = "persons"
--   }

-- gdpx = Indicator
--   { code = "GDP"
--   , name = "Gross Domestic Product"
--   , unit = "USD"
--   }

newtype IndicatorId =
    IndicatorId Int
    deriving (Eq, Ord, Show)

data Aggregation
    = Sum
    | Mean
    | WeightedBy Indicator
    | NotAggregatable

data IndicatorInfo = IndicatorInfo
    { unit        :: String
    -- , description :: String
    , aggregation :: Aggregation
    -- , decimals    :: Int
    }

indicatorInfo :: Indicator -> IndicatorInfo
indicatorInfo Population =
    IndicatorInfo
        { aggregation = Sum
        , unit = "million"
        }

indicatorInfo LifeExpectancy =
    IndicatorInfo
        { aggregation = WeightedBy Population
        , unit = "years"
        }

indicatorInfo PopulationDensity =
    IndicatorInfo
        { aggregation = WeightedBy Area
        , unit = "persons/km²"
        }


indicatorInfo GDP =
    IndicatorInfo { aggregation = WeightedBy Population
                    , unit = "billion USD"}

-- indicatorInfo Area =
--     IndicatorInfo Sum "km²"

