-----------------------------------------------------------------------------
--
-- Module      :   countries and regions
-----------------------------------------------------------------------------

module R4C.Countries   
     where
import UniformBase  
-- import qualified Data.Map.Strict as M

-- import qualified Data.Map.Strict as M

-- data Country
--     = DEU | FRA | ITA | ESP | USA | CAN | GBR | JPN
--     deriving (Eq, Ord, Show)

newtype CountryId   = CountryId Text      -- ISO alpha-3 code


data Region
    = EU
    | Europe
    | G7
    | OECD
    deriving (Eq, Ord, Show)



members :: Region -> [CountryId]
members EU =
    [DEU, FRA, ITA, ESP]
members Europe =
    [DEU, FRA, ITA, ESP, GBR]
members G7 =
    [DEU, FRA, ITA, GBR, USA, CAN, JPN]
members OECD =
    [DEU, FRA, ITA, ESP, GBR, USA, CAN, JPN]

---------------- OBSERVATIONS
newtype IndicatorId = IndicatorId Int

data Observation = Observation
  { obsCountry   :: CountryId
  , obsYear      :: Year
  , obsIndicator :: IndicatorId
  , obsValue     :: Double
  }


